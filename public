/* FINAL LOGIN LAYOUT RESET — centered and interactive */
html, body { width:100%; min-height:100%; margin:0; }
body { overflow-x:hidden; }
#login.login-screen {
  position:fixed !important;
  inset:0 !important;
  width:100% !important;
  height:100dvh !important;
  min-height:100vh !important;
  margin:0 !important;
  padding:24px !important;
  box-sizing:border-box !important;
  display:flex !important;
  align-items:center !important;
  justify-content:center !important;
  overflow-y:auto !important;
  overflow-x:hidden !important;
  isolation:isolate !important;
}
#login .login-backdrop {
  position:absolute !important;
  inset:0 !important;
  z-index:-1 !important;
  pointer-events:none !important;
}
#login .login-card {
  position:relative !important;
  inset:auto !important;
  top:auto !important;
  right:auto !important;
  bottom:auto !important;
  left:auto !important;
  transform:none !important;
  float:none !important;
  flex:none !important;
  align-self:center !important;
  justify-self:auto !important;
  margin:auto !important;
  width:min(470px, 100%) !important;
  max-height:calc(100dvh - 48px) !important;
  box-sizing:border-box !important;
  overflow-y:auto !important;
  z-index:2 !important;
}
#login .login-form,
#login .login-form label,
#login .login-form input,
#login .login-form button { position:relative !important; z-index:3 !important; }
#login .login-form input {
  pointer-events:auto !important;
  user-select:text !important;
  -webkit-user-select:text !important;
  touch-action:auto !important;
}
#login.hidden { display:none !important; }
@media (max-width:600px) {
  #login.login-screen { padding:14px !important; }
  #login .login-card { width:100% !important; max-height:calc(100dvh - 28px) !important; }
}

/* ---------- SANGAT VIBE METER ---------- */
.vibeMeter{margin-top:13px;padding:15px;background:#161513;border:1px solid #302c28;border-radius:15px;max-height:520px;overflow:auto}
.vibeMeter .head{display:flex;align-items:center;justify-content:space-between;gap:8px}
.vibeMeter .head h2{font-size:12px;color:#e0a25e;margin:0;letter-spacing:.05em}
.vibeMeter select{background:#211e1b;border:1px solid #40372f;color:#cfc4b8;border-radius:7px;padding:6px 7px;font-size:9px;outline:none}
.vibeHint{color:#756c63;font-size:10px;margin:8px 0 10px}
.vibeUser{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 0;border-top:1px solid #292622}
.vibeIdentity{display:flex;align-items:center;gap:8px;min-width:0}
.vibeIdentity>i{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;color:#21160f;font-style:normal;font-weight:900;flex:none}
.vibeIdentity div{min-width:0}
.vibeIdentity b,.vibeIdentity small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.vibeIdentity b{font-size:11px}
.vibeIdentity small{font-size:8px;color:#756c63;margin-top:2px}
.vibeActions{display:flex;align-items:center;gap:4px;flex:none}
.vibeActions strong{min-width:28px;text-align:center;color:#aaa097;font-size:11px}
.vibeActions strong.positive{color:#7fd08c}.vibeActions strong.negative{color:#ef8b8b}
.vibeVote{border:1px solid #39332d;background:#211f1c;color:#bdb2a7;border-radius:7px;padding:5px 6px;font-size:11px;line-height:1;cursor:pointer}
.vibeVote:hover{border-color:#a77b50}.vibeVote.selected{background:#3a2b20;border-color:#d88e4a;box-shadow:0 0 0 1px rgba(216,142,74,.15)}
